# Smoke test of sicxe_macro. Run with: cmake -DCLI=<exe> -DDEMO=<asm> -DWORK=<dir> -P cli_smoke.cmake
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

execute_process(COMMAND "${CLI}" "${DEMO}" -o "${WORK}" --tables --trace
                RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "expected exit 0, got ${rc}\n${err}")
endif()
if(NOT EXISTS "${WORK}/MASMAPRG.ASM")
  message(FATAL_ERROR "MASMAPRG.ASM was not written")
endif()
file(READ "${WORK}/MASMAPRG.ASM" content)
if(NOT content MATCHES "FIM003")
  message(FATAL_ERROR "output lacks FIM003:\n${content}")
endif()
if(content MATCHES "MCDEFN")
  message(FATAL_ERROR "output still contains MCDEFN:\n${content}")
endif()
foreach(heading "Name table" "Definition table" "Expansions" "Trace")
  if(NOT out MATCHES "${heading}")
    message(FATAL_ERROR "missing '${heading}' in stdout:\n${out}")
  endif()
endforeach()

# The Name table: each source definition from its MCDEFN line to its MCEND line, the
# creating serial for MULTK, trace content.
foreach(row "SOMA +L +SOMA X,Y,Z +2-7\n" "DOBRA +L +DOBRA V +8-11\n" "MAXIMO +MAXIMO P=,Q=,R=MAIOR +12-19\n"
            "ESCALA +ESCALA K +20-28\n")
  if(NOT out MATCHES "${row}")
    message(FATAL_ERROR "Name table lacks the row '${row}':\n${out}")
  endif()
endforeach()
if(NOT out MATCHES "MULTK [^\n]*#004")
  message(FATAL_ERROR "Name table lacks #004 for MULTK:\n${out}")
endif()
if(NOT out MATCHES "Step[^\n]*\n-+[^\n]*\n *1 +line 1 ")
  message(FATAL_ERROR "the trace has no rows:\n${out}")
endif()

# Usage errors exit 2.
execute_process(COMMAND "${CLI}" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 2 OR NOT err MATCHES "usage")
  message(FATAL_ERROR "no input: expected exit 2 and usage, got ${rc}: ${err}")
endif()
execute_process(COMMAND "${CLI}" "${WORK}/missing.asm" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 2)
  message(FATAL_ERROR "unreadable input: expected exit 2, got ${rc}")
endif()
execute_process(COMMAND "${CLI}" "${DEMO}" --bogus RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 2)
  message(FATAL_ERROR "unknown flag: expected exit 2, got ${rc}")
endif()
execute_process(COMMAND "${CLI}" "${DEMO}" -o RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 2 OR NOT err MATCHES "-o needs a directory" OR NOT err MATCHES "usage")
  message(FATAL_ERROR "-o without a directory: expected exit 2, the reason and usage, got ${rc}: ${err}")
endif()

# A directory is not a source file: exit 2, and nothing is written.
file(MAKE_DIRECTORY "${WORK}/dir-input" "${WORK}/dir-output")
execute_process(COMMAND "${CLI}" "${WORK}/dir-input" -o "${WORK}/dir-output" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 2 OR NOT err MATCHES "is a directory")
  message(FATAL_ERROR "directory input: expected exit 2 and a reason, got ${rc}: ${err}")
endif()
if(EXISTS "${WORK}/dir-output/MASMAPRG.ASM")
  message(FATAL_ERROR "directory input: MASMAPRG.ASM must not be written")
endif()

# A macro error exits 1, names file:line:column on stderr and still writes the output.
file(WRITE "${WORK}/bad.asm" "        MCDEFN\n        FOO\n        NOP\n        END\n")
execute_process(COMMAND "${CLI}" "${WORK}/bad.asm" -o "${WORK}" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 1 OR NOT err MATCHES "bad.asm:[0-9]+:[0-9]+: error: ")
  message(FATAL_ERROR "macro error: expected exit 1 and diagnostic, got ${rc}: ${err}")
endif()
