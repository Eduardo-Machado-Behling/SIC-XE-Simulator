@startuml
title Parser Logic - High-Level Flow
left to right direction
skinparam linetype ortho
skinparam shadowing false
skinparam state {
  BackgroundColor #F1F1F1
  BorderColor #181818
  ArrowColor #181818
}

[*] --> ReadLine
state "Read and clean line\n(remove comments)" as ReadLine
state "Usable code?" as HasCode <<choice>>
state "Ignore blank or comment" as Ignore
state "Identify label and operation" as Identify
state "Known operation?" as Known <<choice>>
state "Report unknown operation" as Unknown
state "Split operands and select parser" as Prepare
state "Instruction?" as IsInstruction <<choice>>
state "Parse instruction\n(validate format and operands)" as ParseInstruction
state "Parse directive\n(validate directive operands)" as ParseDirective
state "Build Statement\n(fields, source positions, diagnostics)" as Build

ReadLine --> HasCode
HasCode --> Ignore : no
HasCode --> Identify : yes
Identify --> Known
Known --> Unknown : no
Known --> Prepare : yes
Prepare --> IsInstruction
IsInstruction --> ParseInstruction : yes
IsInstruction --> ParseDirective : no
ParseInstruction --> Build
ParseDirective --> Build
Unknown --> Build
Ignore --> [*]
Build --> [*]
@enduml
