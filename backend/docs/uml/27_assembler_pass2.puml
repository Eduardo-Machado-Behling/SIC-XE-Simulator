@startuml
title Pass 2: statement evaluation, encoding, and emission
skinparam linetype ortho
skinparam shadowing false

start
:Visit statements in source order;
while (More statements?) is (yes)
  :Select next Statement;
  if (Statement valid after pass 1?) then (yes)
    if (Instruction?) then (yes)
      :Delegate instruction encoding to
      41_instruction_encoding_flow.puml;
    else (directive)
      switch (Directive)
      case (BYTE)
        :Copy parsed literal bytes;
        :Evaluate numeric items in order;
        :Require each numeric value -128..255;
        :Build byte vector;
      case (WORD)
        :Evaluate expressions in order;
        :Require each value -2^23..2^24-1;
        :Append each value as 3 big-endian bytes;
        :Record 6-half-byte relocation for each relocatable item;
      case (BASE)
        :Evaluate expression and set active BASE value;
      case (NOBASE)
        :Clear active BASE value;
      case (END)
        if (Entry expression present?) then (yes)
          :Evaluate expression and set entry point;
        else (no)
          :Keep default entry point;
        endif
      case (START / RESB / RESW / EQU / ORG)
        :No pass-2 bytes;
      endswitch
    endif
  endif
  :For produced BYTE, WORD, or instruction bytes call emit();
  note right
    emit checks each destination address in order.
    On overlap it reports an error and marks the statement invalid.
    Successful emission stores bytes in sparse CodeMemory and Statement::bytes.
  end note
  :Append listing row for every statement;
  note right
    Includes statement address, bytes successfully associated
    with the statement, and original source text.
  end note
endwhile (no)
:Return from Engine::pass2();
:Engine::run finalizes AssemblyInfo;
:Include memory, relocations, listing, diagnostics,
symbols and source metadata in AssemblyResult;
stop
@enduml
