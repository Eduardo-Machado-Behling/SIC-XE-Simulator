@startuml
skinparam linetype ortho
title Pass 2: emission and metadata
start
while (next Statement?) is (yes)
  if (Statement.valid?) then (yes)
    if (directive?) then (yes)
      switch (directive)
      case (BYTE)
        :Convert literals or evaluate values;
        :Range-check and form byte vector;
      case (WORD)
        :Evaluate each value;
        :Range-check 24-bit value;
        :Form three big-endian bytes;
        :Add 6-half-byte relocation when relocatable;
      case (BASE)
        :Set active base value;
      case (NOBASE)
        :Clear active base value;
      case (END)
        :Resolve optional entry expression;
      case (layout-only)
        :No object bytes;
      endswitch
    else (instruction)
      switch (operand schema)
      case (None / Reg / RegReg / RegCount / Number)
        :Encode fixed schema fields;
      case (Memory, SIC mode)
        :Validate 15-bit address;
        :Encode SIC address and X bit;
      case (Memory, SIC/XE mode)
        :Encode n/i mode;
        if (format 4?) then (yes)
          :Validate 20-bit target;
          :Encode x/e/address;
          :Add 5-half-byte relocation when relocatable;
        else (format 3)
          :Select immediate, PC, BASE or direct field;
          :Range-check displacement;
          :Encode x/b/p and 12-bit field;
        endif
      endswitch
    endif
  endif
  :emit() checks each address for overlap;
  :Write bytes into sparse CodeMemory;
  :Append listing row for the statement;
endwhile (no)
:Return from Engine::pass2();
:Engine::run finalizes AssemblyInfo;
:Collect symbol references and instruction source map;
:Sort definitions and references by source position;
stop
@enduml

